# 公网域名。客户机 config.json 的 license_api_url 填 https://<DOMAIN>/api/verify
DOMAIN=ezchat.bond
ACME_EMAIL=jialiangrao@gmail.com
POSTGRES_PASSWORD=change-me
# 编排会连到已有 PostgreSQL 容器的 5432，并使用名为 license 的库
DATABASE_URL=postgresql+psycopg://postgres:change-me@host.docker.internal:5432/license
PROJECT_SECRET=replace-with-project-secret
JWT_SECRET=replace-with-long-random-secret
# Must match gateway EZCHAT_JWT_SECRET. Access tokens carry this value as iss.
JWT_ISSUER=ezchat
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
COOKIE_SECURE=true
